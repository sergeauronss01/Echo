# Echo - Personal Music Manager
# Environment Configuration File
#
# IMPORTANT: Before starting this application, ensure you have installed:
#   1. Node.js 16+ and npm
#   2. Python 3.8+ (with pip)
#   3. FFmpeg (for audio processing)
#   4. All Python dependencies: pip install -r requirements.txt
#
# For development: NODE_ENV=development
# For production: NODE_ENV=production (do NOT use development secrets)

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
# Local Development Example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/song_manager
#
# Supabase Example (after Phase 2 migration):
#   DATABASE_URL=postgresql://user:password@project.supabase.co:5432/postgres
#
# REQUIRED: Must be set before starting the application
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/song_manager

# Authentication Secrets
# IMPORTANT: In production, use strong random values. Do NOT use development defaults.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
# Get these from Google Developer Console: https://console.developers.google.com/
# Create OAuth 2.0 credentials (Desktop application type)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# YouTube API Configuration
# Get this from YouTube Data API in Google Developer Console
# Rate Limit: 10,000 quota per day
YT_API_KEY=your_youtube_api_key_here

# File Storage
# Download directory for audio files. Will be created if it doesn't exist.
# Leave blank to default to ~/Downloads/echo-downloads
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE=104857600

# CORS Configuration
# For development: allow all origins with '*'
# For production: set to your frontend domain (e.g., https://echo.example.com)
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Optional: Redis Caching (not currently used)
# REDIS_URL=redis://localhost:6379

# DO NOT MODIFY THESE (set automatically):
# FINGERPRINTING_ENABLED, FINGERPRINTING_MODEL_PATH
