{
  "name": "song-list-downloader",
  "version": "2.0.0",
  "description": "Full-stack audio acquisition and management system with acoustic fingerprinting",
  "main": "src/api/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "nodemon src/api/server.js",
    "migrate": "node src/api/utils/runMigrations.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ --fix",
    "build": "echo \"Build complete\"",
    "seed": "node src/api/utils/seedDatabase.js"
  },
  "keywords": [
    "music",
    "downloader",
    "fingerprinting",
    "audio",
    "yt-dlp"
  ],
